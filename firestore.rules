rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function membership(workspaceId) {
      return signedIn()
        && exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid))
        && (!('disabledAt' in get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)).data)
          || get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)).data.disabledAt == null);
    }

    function role(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)).data.role;
    }

    function canEdit(workspaceId) {
      return membership(workspaceId) && (role(workspaceId) == 'owner' || role(workspaceId) == 'editor');
    }

    function isOwner(workspaceId) {
      return membership(workspaceId) && role(workspaceId) == 'owner';
    }

    match /workspaces/{workspaceId} {
      allow read: if membership(workspaceId);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isOwner(workspaceId);
      allow delete: if false;

      match /members/{memberId} {
        allow read: if membership(workspaceId);
        allow create: if isOwner(workspaceId)
          || (signedIn()
            && memberId == request.auth.uid
            && request.resource.data.role == 'owner'
            && getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid)
          || (signedIn()
            && memberId == request.auth.uid
            && request.resource.data.inviteId != null
            && get(/databases/$(database)/documents/workspaces/$(workspaceId)/invites/$(request.resource.data.inviteId)).data.status == 'pending'
            && get(/databases/$(database)/documents/workspaces/$(workspaceId)/invites/$(request.resource.data.inviteId)).data.email == request.auth.token.email
            && get(/databases/$(database)/documents/workspaces/$(workspaceId)/invites/$(request.resource.data.inviteId)).data.role == request.resource.data.role);
        allow update, delete: if isOwner(workspaceId);
      }

      match /invites/{inviteId} {
        allow read: if isOwner(workspaceId)
          || (signedIn() && resource.data.email == request.auth.token.email);
        allow create: if isOwner(workspaceId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.status == 'pending';
        allow update: if signedIn()
          && resource.data.status == 'pending'
          && request.resource.data.status == 'accepted'
          && request.resource.data.acceptedBy == request.auth.uid
          && request.auth.token.email == resource.data.email;
        allow delete: if isOwner(workspaceId);
      }

      match /{collection}/{documentId} {
        allow read: if membership(workspaceId);
        allow create: if canEdit(workspaceId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.version == 1;
        allow update: if canEdit(workspaceId)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.version == resource.data.version + 1
          && request.resource.data.updatedBy == request.auth.uid;
        allow delete: if membership(workspaceId);
      }
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && userId == request.auth.uid;
      allow delete: if false;

      match /memberships/{workspaceId} {
        allow read: if signedIn() && userId == request.auth.uid;
        allow create: if (signedIn()
          && userId == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.role == 'owner'
          && getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid)
          || (signedIn()
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.inviteId != null
            && get(/databases/$(database)/documents/workspaces/$(workspaceId)/invites/$(request.resource.data.inviteId)).data.status == 'pending'
            && get(/databases/$(database)/documents/workspaces/$(workspaceId)/invites/$(request.resource.data.inviteId)).data.email == request.auth.token.email
            && get(/databases/$(database)/documents/workspaces/$(workspaceId)/invites/$(request.resource.data.inviteId)).data.role == request.resource.data.role)
          || isOwner(workspaceId);
        allow update, delete: if false;
      }
    }
  }
}
