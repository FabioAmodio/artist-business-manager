{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "artist-business-manager": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "outputPath": "dist/artist-business-manager",
            "baseHref": "/artist-business-manager/",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "12kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "test": {
              "baseHref": "/artist-business-manager-test/",
              "fileReplacements": [
                {
                  "replace": "src/app/core/configuration/environment.providers.ts",
                  "with": "src/app/core/configuration/environment.providers.test.ts"
                }
              ],
              "assets": [
                { "glob": "**/*", "input": "public" },
                { "glob": "artist-business-manager-data-test.json", "input": "docs/business", "output": "assets" }
              ]
            },
            "demo": {
              "baseHref": "/artist-business-manager-demo/",
              "fileReplacements": [
                {
                  "replace": "src/app/core/configuration/environment.providers.ts",
                  "with": "src/app/core/configuration/environment.providers.demo.ts"
                }
              ],
              "assets": [
                { "glob": "**/*", "input": "public" },
                { "glob": "artist-business-manager-data-test.json", "input": "docs/business", "output": "assets" }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "artist-business-manager:build:production"
            },
            "development": {
              "buildTarget": "artist-business-manager:build:development"
            },
            "test": {
              "buildTarget": "artist-business-manager:build:test"
            },
            "demo": {
              "buildTarget": "artist-business-manager:build:demo"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "exclude": [
              "src/environments/environment.test.ts"
            ]
          }
        }
      }
    }
  }
}
